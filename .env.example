# Copy to .env.local and fill in. Never commit the real file.

# --- Customer chatbot + "Fill with AI" in admin ---
OPENAI_API_KEY=sk-...
# Any model with tool calling (chatbot) and structured outputs + vision (admin). Default: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
# Optional: a different model just for the admin AI fill
ADMIN_AI_MODEL=
# Messages per minute per visitor (protects your token). Default 20
CHAT_RATE_LIMIT=20

# --- Admin (/admin) ---
# Admin is disabled until this is set. Use a long password.
ADMIN_PASSWORD=
# Long random text, e.g. from: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Data ---
# Folder for the database and uploaded photos. Back it up! Default: ./data
DATA_DIR=

# --- Where orders, contact messages and chatbot leads go ---
# A URL that receives each submission as JSON (Zapier, Make, n8n, Google Apps Script…).
# Without it they're appended to DATA_DIR/submissions.jsonl.
LEAD_WEBHOOK_URL=
# Also keep the local file when a webhook is set
SAVE_SUBMISSIONS_TO_FILE=false

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
