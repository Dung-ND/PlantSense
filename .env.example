# Copy to .env.local and fill in. Never commit the real file.

# --- Chatbot (required for the assistant) ---
OPENAI_API_KEY=sk-...
# Any chat model with tool calling. Optional, default: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
# Messages per minute per visitor (protects your token). Optional, default 20
CHAT_RATE_LIMIT=20

# --- Where orders, contact messages and chatbot leads go ---
# A URL that receives each submission as JSON (Zapier, Make, n8n, Google Apps Script…).
# Without it they're appended to data/submissions.jsonl (only works on a server with a disk).
LEAD_WEBHOOK_URL=
# Also keep the local file when a webhook is set
SAVE_SUBMISSIONS_TO_FILE=false

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
