# systemd service: copy to /etc/systemd/system/plantsense.service
[Unit]
Description=PlantSense shop
After=network.target

[Service]
Type=simple
User=plantsense
WorkingDirectory=/home/plantsense/plantsense
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
